{
  "name": "netnebula",
  "version": "1.0.0",
  "description": "A 3D map of the most linked domains on the web, built from the Common Crawl web graph.",
  "private": true,
  "scripts": {
    "serve": "firebase emulators:start --only hosting",
    "test": "python pipeline/test_build_graph.py",
    "graph": "python pipeline/build_graph.py",
    "graph:small": "python pipeline/build_graph.py --size 2000",
    "deploy": "firebase deploy --only hosting"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SPTApyo/NetNebula.git"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/SPTApyo/NetNebula/issues"
  },
  "homepage": "https://github.com/SPTApyo/NetNebula#readme"
}
