rules_version = '2';

// NetNebula: the database is public to read and closed to writes.
//
// The crawler writes through the Admin SDK (service account), which bypasses
// these rules entirely. No web client therefore needs write access, not even
// Authentication is disabled; writes remain blocked.
service cloud.firestore {
  match /databases/{database}/documents {

    // The graph the viewer displays.
    match /pages/{page} {
      allow read: if true;
      allow write: if false;
    }

    // Counters and the list of domains, shown in the interface.
    match /meta/{doc} {
      allow read: if true;
      allow write: if false;
    }

    // The crawler work queue: internal state, invisible to clients.
    match /frontier/{doc} {
      allow read, write: if false;
    }

    // Everything else is closed, including the collections left over from the
    // old "one collection per domain" schema.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
